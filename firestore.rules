rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/workoutSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/workoutSheets/{sheetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/mealPhotoAnalyses/{analysisId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/bikeMeta/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/climbingGear/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/activeWorkout/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/bodyEvolutionMeta/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/bodyEvolutionEvaluations/{evaluationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/dailyWellness/{dayKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/wellnessMeta/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/mealPlan/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Treino em dupla/equipe — grupos em duoTeams + users/{uid}/duoMemberships.
    // HealthFit Coach — personal ativo pode ler/atualizar perfil do aluno vinculado
    // (peso, altura, medidas) via linkId previsível: {coachUid}_{studentUid}_personal
    function isActivePersonalCoachOf(studentUid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + studentUid + '_personal'))
        && get(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + studentUid + '_personal')).data.coachUid == request.auth.uid
        && get(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + studentUid + '_personal')).data.studentUid == studentUid
        && get(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + studentUid + '_personal')).data.profession == 'personal'
        && get(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + studentUid + '_personal')).data.status in ['active', 'blockedPlan'];
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isActivePersonalCoachOf(userId));
      allow write: if request.auth != null
        && (request.auth.uid == userId || isActivePersonalCoachOf(userId));
    }

    match /exerciseVideos/{videoId} {
      // Catálogo compartilhado: clientes só leem.
      // Seed/update via Admin SDK / console (rules não se aplicam ao Admin).
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Treino em dupla/equipe — grupos em duoTeams + vínculo em users/{uid}/duoMemberships.
    function isDuoMember(teamId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/duoTeams/$(teamId)).data.get('memberUids', []);
    }

    function hasDuoMembership(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/duoMemberships/$(teamId));
    }

    // Acesso temporário para aceitar convite (escrito ao convidar alguém do app).
    function hasDuoJoinAccess(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/duoJoinAccess/$(teamId));
    }

    match /duoTeams/{teamId} {
      // get: qualquer autenticado com o ID do doc (UUID vem do convite).
      // list: só quem já participa — evita varrer todas as equipes.
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && (request.auth.uid in resource.data.get('memberUids', [])
            || hasDuoMembership(teamId));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid
        && request.auth.uid in request.resource.data.get('memberUids', []);
      // Quem aceita o convite inclui o próprio uid em memberUids no update.
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.get('memberUids', [])
            || request.auth.uid in request.resource.data.get('memberUids', [])
            || hasDuoMembership(teamId)
            || hasDuoJoinAccess(teamId));
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.createdByUid
            || request.auth.uid in resource.data.get('memberUids', [])
            || hasDuoMembership(teamId));

      match /messages/{messageId} {
        allow read, create: if isDuoMember(teamId) || hasDuoMembership(teamId);
        allow update, delete: if isDuoMember(teamId) || hasDuoMembership(teamId);
      }

      match /memberStats/{memberUid} {
        allow read: if isDuoMember(teamId) || hasDuoMembership(teamId);
        allow create, update: if request.auth != null
          && request.auth.uid == memberUid
          && (isDuoMember(teamId) || hasDuoMembership(teamId));
        allow delete: if request.auth != null
          && (request.auth.uid == memberUid
              || request.auth.uid == get(/databases/$(database)/documents/duoTeams/$(teamId)).data.createdByUid);
      }
    }

    match /duoInvites/{inviteId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || resource.data.status == 'pending'
            || resource.data.get('toUid', '') == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || resource.data.status == 'pending'
            || resource.data.get('toUid', '') == request.auth.uid);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.fromUid;
    }

    // Lookup por código de convite (get por ID do código).
    match /duoInviteCodes/{code} {
      allow get: if request.auth != null
        && (resource.data.status == 'pending'
            || resource.data.fromUid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;
      // Remetente ou quem responde um convite ainda pendente (aceite/recusa/retirada).
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined', 'cancelled']));
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.fromUid;
    }

    match /users/{userId}/duoMemberships/{teamId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Dono do vínculo OU membro atual da equipe (para adicionar alguém pelo app).
      allow create, update: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid in get(/databases/$(database)/documents/duoTeams/$(teamId)).data.get('memberUids', []));
      allow delete: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid in get(/databases/$(database)/documents/duoTeams/$(teamId)).data.get('memberUids', []));
    }

    // Token de entrada enquanto o convite está pendente (aceite no app).
    match /users/{userId}/duoJoinAccess/{teamId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid == request.resource.data.fromUid);
    }

    // Diretório mínimo (nome + como quer ser chamado) para convites em dupla/equipe.
    match /userDirectory/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Registros de acesso (Marco Civil da Internet — Lei 12.965/2014, art. 15).
    // Retenção 6 meses via campo expiresAt (TTL nativo + Function purgeExpiredAccessLogs).
    match /accessLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'event', 'createdAt', 'expiresAt']);
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Feedback do app (reclamações/sugestões). Só o autor cria/lê; e-mail sai na Function.
    match /appFeedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['Reclamação', 'Sugestão', 'Melhoria', 'Dúvida']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Tokens FCM para push Duo (Cloud Functions).
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/duoPendingInvites/{inviteId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid == request.resource.data.fromUid);
      allow update, delete: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid == resource.data.fromUid);
    }

    // Notificações de dupla/equipe (ex.: “você foi adicionado a um grupo”).
    match /users/{userId}/duoNotifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
    }

    match /users/{userId}/duoReadCursors/{teamId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vouchers de cortesia (30 dias). Só Admin SDK / Cloud Function escreve.
    match /courtesyVouchers/{code} {
      allow read, write: if false;
    }

    // Brinde ativo por conta — o cliente lê o próprio; escrita só via Function.
    match /courtesyGrants/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Kite Spot Buddy — presença temporária durante sessão de kitesurf (opt-in).
    match /kiteSpotPresence/{uid} {
      allow read: if request.auth != null
        && resource.data.visible == true
        && resource.data.expiresAt > request.time;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.isKitesurf == true
        && request.resource.data.visible == true;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // HealthFit Coach — personal/nutri ↔ aluno (sem localização em tempo real).
    // Autorização = memberUids no coachLinks. Memberships são só índice (não atalho de auth).
    function coachLinkData(linkId) {
      return get(/databases/$(database)/documents/coachLinks/$(linkId)).data;
    }

    function isCoachLinkMember(linkId) {
      return request.auth != null
        && request.auth.uid in coachLinkData(linkId).get('memberUids', []);
    }

    function isCoachLinkActive(linkId) {
      return coachLinkData(linkId).get('status', '') == 'active';
    }

    function isCoachOfLink(linkId) {
      return request.auth != null
        && request.auth.uid == coachLinkData(linkId).get('coachUid', '');
    }

    // Índice em users/{uid}/coachMemberships — só quem já está em memberUids pode criar.
    function canWriteCoachMembership(userId, linkId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/coachLinks/$(linkId))
        && request.auth.uid in coachLinkData(linkId).get('memberUids', [])
        && userId in coachLinkData(linkId).get('memberUids', []);
    }

    match /coachProfiles/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || (resource != null && resource.data.isDirectoryVisible == true));
      // Dono do doc = Auth UID. create e update (inclui set+merge).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /coachLinks/{linkId} {
      // Sem GET aberto: linkId é previsível (coachUid_studentUid_profession).
      allow get: if request.auth != null
        && request.auth.uid in resource.data.get('memberUids', []);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.get('memberUids', []);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.get('memberUids', [])
        && request.resource.data.keys().hasAll(['coachUid', 'studentUid', 'memberUids', 'status', 'profession'])
        && request.auth.uid in [request.resource.data.coachUid, request.resource.data.studentUid];
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.get('memberUids', [])
            || request.auth.uid in request.resource.data.get('memberUids', []));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.get('memberUids', []);

      match /messages/{messageId} {
        allow read: if isCoachLinkMember(linkId);
        allow create: if isCoachLinkMember(linkId)
          && isCoachLinkActive(linkId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.linkId == linkId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // Remetente edita a própria; destinatário só atualiza entregue/lida (não muda texto/remetente).
        allow update: if isCoachLinkMember(linkId)
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.linkId == resource.data.linkId
          && request.resource.data.text == resource.data.text
          && (
            request.auth.uid == resource.data.senderUid
            || request.auth.uid != resource.data.senderUid
          );
        allow delete: if isCoachLinkMember(linkId)
          && resource.data.senderUid == request.auth.uid;
      }

      match /assignedWorkouts/{workoutId} {
        // Coach sempre lê; aluno só com vínculo ativo (Fit+ refletido no status).
        allow read: if isCoachLinkMember(linkId)
          && (isCoachOfLink(linkId) || isCoachLinkActive(linkId));
        allow create, update: if isCoachOfLink(linkId)
          && request.auth.uid == request.resource.data.coachUid
          && request.resource.data.linkId == linkId
          && request.resource.data.studentUid == coachLinkData(linkId).studentUid;
        allow delete: if isCoachOfLink(linkId)
          || (isCoachLinkMember(linkId) && request.auth.uid == resource.data.coachUid);
      }

      match /mealPlan/{docId} {
        allow read: if isCoachLinkMember(linkId)
          && (isCoachOfLink(linkId) || isCoachLinkActive(linkId));
        allow create, update: if isCoachOfLink(linkId)
          && request.auth.uid == request.resource.data.coachUid
          && request.resource.data.linkId == linkId;
        allow delete: if isCoachOfLink(linkId)
          && request.auth.uid == resource.data.coachUid;
      }
    }

    match /coachInvites/{inviteId} {
      // get (não list): aceitar código precisa ler o invite pendente pelo ID do lookup.
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || resource.data.get('toUid', '') == request.auth.uid
            || resource.data.status == 'pending');
      allow list: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || resource.data.get('toUid', '') == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined', 'cancelled']));
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.fromUid;
    }

    match /coachInviteCodes/{code} {
      allow get: if request.auth != null
        && (resource.data.status == 'pending'
            || resource.data.fromUid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined', 'cancelled']));
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.fromUid;
    }

    match /users/{userId}/coachMemberships/{linkId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Aluno (ou coach) membro do link pode indexar o outro membro — sem self-grant de estranhos.
      allow create, update: if canWriteCoachMembership(userId, linkId);
      allow delete: if request.auth != null
        && (request.auth.uid == userId || canWriteCoachMembership(userId, linkId));
    }
  }
}
