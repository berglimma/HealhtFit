rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/workoutSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/bodyEvolutionMeta/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/bodyEvolutionEvaluations/{evaluationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/dailyWellness/{dayKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/wellnessMeta/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/mealPlan/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /exerciseVideos/{videoId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
