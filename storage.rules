rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Vídeos de demonstração: qualquer usuário autenticado.
    match /exerciseVideos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Evolução corporal: somente o próprio usuário (fotos e PDFs privados).
    match /users/{userId}/bodyEvolution/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
