rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Vídeos de demonstração: clientes só leem.
    // Upload inicial via Admin SDK / ferramenta interna (não no startup do app).
    match /exerciseVideos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Evolução corporal: somente o próprio usuário (fotos e PDFs privados).
    match /users/{userId}/bodyEvolution/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Foto de perfil: dono escreve; qualquer autenticado lê (dupla/equipe).
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Capa do grupo (dupla/equipe): membros leem/escrevem.
    match /duoTeams/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (
          request.auth.uid in firestore.get(
            /databases/(default)/documents/duoTeams/$(teamId)
          ).data.get('memberUids', [])
          || firestore.exists(
            /databases/(default)/documents/users/$(request.auth.uid)/duoMemberships/$(teamId)
          )
        );
    }

    // HealthFit Pulse — imagens de posts e stories (mesmo path pulse/{uid}/{file}.jpg).
    // contentType image/*; máx. 8 MB. Isolado de exerciseVideos/users/duoTeams.
    match /pulse/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
